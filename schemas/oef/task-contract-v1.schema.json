{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opencodex.local/schemas/oef/task-contract-v1.schema.json",
  "title": "OEF Task Contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "revision", "title", "goal", "scope", "constraints", "acceptance_criteria", "risk", "budgets", "extensions"],
  "properties": {
    "schema_version": { "const": 1 },
    "task_id": { "type": "string", "pattern": "^task:[A-Za-z0-9][A-Za-z0-9._:@/-]*$" },
    "revision": { "type": "integer", "minimum": 1 },
    "title": { "type": "string", "minLength": 1, "maxLength": 500 },
    "goal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary"],
      "properties": { "summary": { "type": "string", "minLength": 1, "maxLength": 20000 } }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["included", "excluded"],
      "properties": {
        "included": { "type": "array", "minItems": 1, "maxItems": 256, "items": { "type": "string", "minLength": 1, "maxLength": 2000 } },
        "excluded": { "type": "array", "maxItems": 256, "items": { "type": "string", "minLength": 1, "maxLength": 2000 } }
      }
    },
    "constraints": { "type": "array", "maxItems": 256, "items": { "type": "string", "minLength": 1, "maxLength": 5000 } },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "statement", "required_evidence"],
        "properties": {
          "key": { "type": "string", "minLength": 1, "maxLength": 160 },
          "statement": { "type": "string", "minLength": 1, "maxLength": 10000 },
          "required_evidence": { "type": "array", "maxItems": 64, "items": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9-]*(?:\\.[a-zA-Z0-9][a-zA-Z0-9-]*)+$" } }
        }
      }
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "reasons"],
      "properties": {
        "level": { "enum": ["low", "medium", "high", "critical"] },
        "reasons": { "type": "array", "maxItems": 64, "items": { "type": "string", "minLength": 1, "maxLength": 160 } }
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_attempts", "max_parallel_writers", "max_cost_units"],
      "properties": {
        "max_attempts": { "type": "integer", "minimum": 1, "maximum": 10000 },
        "max_parallel_writers": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "max_cost_units": { "type": "number", "minimum": 0 }
      }
    },
    "extensions": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-zA-Z0-9][a-zA-Z0-9-]*(?:\\.[a-zA-Z0-9][a-zA-Z0-9-]*)+$" },
      "additionalProperties": {
        "type": "object",
        "required": ["schema_version"],
        "properties": { "schema_version": { "type": "integer", "minimum": 1 } }
      }
    }
  }
}
