{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opencodex.local/schemas/oef/trace-span-v1.schema.json",
  "title": "OEF Trace Span v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "trace_id", "span_id", "parent_span_id", "name", "status", "started_at", "ended_at", "attributes"],
  "properties": {
    "schema_version": { "const": 1 },
    "trace_id": { "type": "string", "minLength": 1 },
    "span_id": { "type": "string", "minLength": 1 },
    "parent_span_id": { "oneOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
    "name": { "type": "string", "minLength": 1, "maxLength": 300 },
    "status": { "enum": ["ok", "error"] },
    "started_at": { "type": "string", "format": "date-time" },
    "ended_at": { "type": "string", "format": "date-time" },
    "attributes": { "type": "object" }
  }
}
