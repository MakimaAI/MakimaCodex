{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opencodex.local/schemas/oef/artifact-ref-v1.schema.json",
  "title": "OEF Artifact Reference v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_id", "content_hash", "media_type", "size_bytes", "classification", "retention_policy", "created_by", "storage_key", "deduplicated"],
  "properties": {
    "artifact_id": { "type": "string", "minLength": 1 },
    "content_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "media_type": { "type": "string", "minLength": 1, "maxLength": 200 },
    "size_bytes": { "type": "integer", "minimum": 0 },
    "classification": { "enum": ["public", "internal", "confidential"] },
    "retention_policy": { "type": "string", "minLength": 1, "maxLength": 200 },
    "created_by": { "$ref": "actor-v1.schema.json" },
    "storage_key": { "type": "string", "pattern": "^[a-f0-9]{2}/[a-f0-9]{2}/[a-f0-9]{64}$" },
    "deduplicated": { "type": "boolean" }
  }
}
