{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "number",
      "const": 1
    },
    "attempt_id": {
      "type": "string",
      "pattern": "^attempt:[A-Za-z0-9][A-Za-z0-9._:@/-]*$"
    },
    "execution_id": {
      "type": "string",
      "pattern": "^execution:[A-Za-z0-9][A-Za-z0-9._:@/-]*$"
    },
    "attempt_number": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "base_commit": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "workspace_id": {
      "type": "string",
      "pattern": "^workspace:[A-Za-z0-9][A-Za-z0-9._:@/-]*$"
    },
    "workspace_root": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "context_bundle_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "binding_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "status": {
      "type": "string",
      "enum": [
        "CREATED",
        "LEASED",
        "WORKSPACE_PREPARING",
        "CONTEXT_PREPARING",
        "STARTING",
        "RUNNING",
        "COLLECTING",
        "VERIFYING",
        "SUCCEEDED",
        "FAILED",
        "CANCELLED",
        "ORPHANED"
      ]
    },
    "failure_of_previous_attempt": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "retry_strategy": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            }
          },
          "required": [
            "type",
            "retry_strategy"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "started_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
        },
        {
          "type": "null"
        }
      ]
    },
    "ended_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "attempt_id",
    "execution_id",
    "attempt_number",
    "base_commit",
    "workspace_id",
    "context_bundle_hash",
    "binding_hash",
    "status",
    "failure_of_previous_attempt",
    "started_at",
    "ended_at"
  ],
  "additionalProperties": false,
  "$id": "https://opencodex.local/schemas/oef/phase2/execution-attempt-v1.schema.json"
}
