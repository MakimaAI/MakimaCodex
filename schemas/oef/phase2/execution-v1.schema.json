{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "number",
      "const": 1
    },
    "execution_id": {
      "type": "string",
      "pattern": "^execution:[A-Za-z0-9][A-Za-z0-9._:@/-]*$"
    },
    "assignment_id": {
      "type": "string",
      "pattern": "^assignment:[A-Za-z0-9][A-Za-z0-9._:@/-]*$"
    },
    "assignment_revision": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "binding_id": {
      "type": "string",
      "pattern": "^binding:[A-Za-z0-9][A-Za-z0-9._:@/-]*$"
    },
    "status": {
      "type": "string",
      "enum": [
        "CREATED",
        "QUEUED",
        "PREPARING",
        "RUNNING",
        "CANCELLING",
        "COMPLETED",
        "FAILED",
        "INTERRUPTED",
        "CANCELLED"
      ]
    },
    "current_attempt_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^attempt:[A-Za-z0-9][A-Za-z0-9._:@/-]*$"
        },
        {
          "type": "null"
        }
      ]
    },
    "attempt_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "started_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
        },
        {
          "type": "null"
        }
      ]
    },
    "completed_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
        },
        {
          "type": "null"
        }
      ]
    },
    "aggregate_version": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "schema_version",
    "execution_id",
    "assignment_id",
    "assignment_revision",
    "binding_id",
    "status",
    "current_attempt_id",
    "attempt_count",
    "created_at",
    "started_at",
    "completed_at",
    "aggregate_version"
  ],
  "additionalProperties": false,
  "$id": "https://opencodex.local/schemas/oef/phase2/execution-v1.schema.json"
}
