{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opencodex.local/schemas/oef/actor-v1.schema.json",
  "title": "OEF Actor v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "id"],
  "properties": {
    "type": { "enum": ["human", "agent", "system", "integration", "scheduler"] },
    "id": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[^\\u0000-\\u001f\\u007f]+$" },
    "model_ref": { "type": "string", "minLength": 1, "maxLength": 300 },
    "runtime_ref": { "type": "string", "minLength": 1, "maxLength": 300 }
  }
}
