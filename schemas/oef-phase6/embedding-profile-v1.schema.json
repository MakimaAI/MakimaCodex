{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]*$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "dimensions": {
      "type": "integer",
      "minimum": 8,
      "maximum": 4096
    },
    "provider": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "max_sensitivity": {
      "type": "string",
      "enum": [
        "PUBLIC",
        "INTERNAL",
        "CONFIDENTIAL",
        "RESTRICTED"
      ]
    }
  },
  "required": [
    "id",
    "version",
    "dimensions",
    "provider",
    "max_sensitivity"
  ],
  "additionalProperties": false,
  "$id": "https://opencodex.local/schemas/oef/phase6/embedding-profile-v1.schema.json"
}
