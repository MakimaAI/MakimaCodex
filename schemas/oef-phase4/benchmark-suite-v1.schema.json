{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "number",
      "const": 1
    },
    "benchmark_suite_id": {
      "type": "string",
      "pattern": "^benchmark-suite:[A-Za-z0-9][A-Za-z0-9._/@-]*$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "target_role": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "evaluator_profile_ref": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "additionalProperties": false
    },
    "environment_profile_ref": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "additionalProperties": false
    },
    "tasks": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "task_id": {
            "type": "string",
            "pattern": "^benchmark-task:[A-Za-z0-9][A-Za-z0-9._/@-]*$"
          },
          "version": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "split": {
            "type": "string",
            "enum": [
              "public_baseline",
              "validation",
              "private_holdout"
            ]
          },
          "category": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "prompt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000
          },
          "hidden_assertions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            }
          },
          "sensitivity": {
            "type": "string",
            "enum": [
              "public",
              "internal",
              "private"
            ]
          },
          "data_policy": {
            "type": "object",
            "properties": {
              "allow_external_provider": {
                "type": "boolean"
              },
              "allowed_providers": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z0-9-]+$"
                }
              }
            },
            "required": [
              "allow_external_provider",
              "allowed_providers"
            ],
            "additionalProperties": false
          },
          "verifier": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "deterministic-json"
              },
              "expected_answer_hash": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              },
              "require_task_binding": {
                "type": "boolean"
              }
            },
            "required": [
              "type",
              "expected_answer_hash",
              "require_task_binding"
            ],
            "additionalProperties": false
          },
          "provenance": {
            "type": "object",
            "properties": {
              "source": {
                "type": "string",
                "minLength": 1
              },
              "license": {
                "type": "string",
                "minLength": 1
              },
              "created_at": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
              },
              "updated_at": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
              },
              "contamination_risk": {
                "type": "string",
                "enum": [
                  "low",
                  "medium",
                  "high"
                ]
              },
              "human_verified_by": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "source",
              "license",
              "created_at",
              "updated_at",
              "contamination_risk",
              "human_verified_by"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "task_id",
          "version",
          "split",
          "category",
          "prompt",
          "hidden_assertions",
          "sensitivity",
          "data_policy",
          "verifier",
          "provenance"
        ],
        "additionalProperties": false
      }
    },
    "license": {
      "type": "object",
      "properties": {
        "allowed_use": {
          "type": "string",
          "const": "evaluation"
        }
      },
      "required": [
        "allowed_use"
      ],
      "additionalProperties": false
    },
    "splits": {
      "type": "object",
      "properties": {
        "public_baseline": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "validation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "private_holdout": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "public_baseline",
        "validation",
        "private_holdout"
      ],
      "additionalProperties": false
    },
    "content_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  },
  "required": [
    "schema_version",
    "benchmark_suite_id",
    "version",
    "target_role",
    "evaluator_profile_ref",
    "environment_profile_ref",
    "tasks",
    "license",
    "splits",
    "content_hash"
  ],
  "additionalProperties": false,
  "$id": "https://opencodex.local/schemas/oef/phase4/benchmark-suite-v1.schema.json"
}
