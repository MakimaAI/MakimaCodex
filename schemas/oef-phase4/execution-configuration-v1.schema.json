{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "number",
      "const": 1
    },
    "execution_config_id": {
      "type": "string",
      "pattern": "^execution-config:[A-Za-z0-9][A-Za-z0-9._/@-]*$"
    },
    "model": {
      "type": "object",
      "properties": {
        "version_id": {
          "type": "string",
          "pattern": "^model-version:[A-Za-z0-9][A-Za-z0-9._/@-]*$"
        },
        "deployment_id": {
          "type": "string",
          "pattern": "^deployment:[A-Za-z0-9][A-Za-z0-9._/@-]*$"
        }
      },
      "required": [
        "version_id",
        "deployment_id"
      ],
      "additionalProperties": false
    },
    "runtime": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^runtime:[A-Za-z0-9][A-Za-z0-9._/@-]*$"
        },
        "adapter_version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        }
      },
      "required": [
        "id",
        "adapter_version"
      ],
      "additionalProperties": false
    },
    "prompt_profile": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "additionalProperties": false
    },
    "tool_bundle": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "additionalProperties": false
    },
    "context_policy": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "additionalProperties": false
    },
    "generation": {
      "type": "object",
      "properties": {
        "temperature": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "max_output_tokens": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "temperature",
        "max_output_tokens"
      ],
      "additionalProperties": false
    },
    "environment": {
      "type": "object",
      "properties": {
        "class": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        }
      },
      "required": [
        "class",
        "version"
      ],
      "additionalProperties": false
    },
    "configuration_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  },
  "required": [
    "schema_version",
    "execution_config_id",
    "model",
    "runtime",
    "prompt_profile",
    "tool_bundle",
    "context_policy",
    "generation",
    "environment",
    "configuration_hash"
  ],
  "additionalProperties": false,
  "$id": "https://opencodex.local/schemas/oef/phase4/execution-configuration-v1.schema.json"
}
