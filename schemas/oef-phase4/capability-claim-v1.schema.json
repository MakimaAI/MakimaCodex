{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "number",
      "const": 1
    },
    "claim_id": {
      "type": "string",
      "pattern": "^capability-claim:[A-Za-z0-9][A-Za-z0-9._/@-]*$"
    },
    "model_version_id": {
      "type": "string",
      "pattern": "^model-version:[A-Za-z0-9][A-Za-z0-9._/@-]*$"
    },
    "capability": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "claimed_value": {
      "type": "string",
      "enum": [
        "supported",
        "partial",
        "unsupported"
      ]
    },
    "source": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "provider-api",
            "official-documentation",
            "official-release-note",
            "runtime-documentation",
            "community-report",
            "local-observation",
            "benchmark-result",
            "human-confirmed"
          ]
        },
        "source_hash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      },
      "required": [
        "type",
        "source_hash"
      ],
      "additionalProperties": false
    },
    "observed_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "confidence": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "claim_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  },
  "required": [
    "schema_version",
    "claim_id",
    "model_version_id",
    "capability",
    "claimed_value",
    "source",
    "observed_at",
    "expires_at",
    "confidence",
    "claim_hash"
  ],
  "additionalProperties": false,
  "$id": "https://opencodex.local/schemas/oef/phase4/capability-claim-v1.schema.json"
}
