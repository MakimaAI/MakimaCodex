{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "number",
      "const": 1
    },
    "observation_id": {
      "type": "string",
      "pattern": "^capability-observation:[A-Za-z0-9][A-Za-z0-9._/@-]*$"
    },
    "execution_config_id": {
      "type": "string",
      "pattern": "^execution-config:[A-Za-z0-9][A-Za-z0-9._/@-]*$"
    },
    "capability": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "probe_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "result": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "passed",
            "partial",
            "failed",
            "unsupported"
          ]
        },
        "valid_calls": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "invalid_calls": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "total_calls": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "status",
        "valid_calls",
        "invalid_calls",
        "total_calls"
      ],
      "additionalProperties": false
    },
    "evidence_refs": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^artifact:[A-Za-z0-9][A-Za-z0-9._/@-]*$"
      }
    },
    "observed_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "reliability": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "confidence_interval": {
      "type": "object",
      "properties": {
        "lower": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "upper": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "lower",
        "upper"
      ],
      "additionalProperties": false
    },
    "observation_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  },
  "required": [
    "schema_version",
    "observation_id",
    "execution_config_id",
    "capability",
    "probe_version",
    "result",
    "evidence_refs",
    "observed_at",
    "reliability",
    "confidence_interval",
    "observation_hash"
  ],
  "additionalProperties": false,
  "$id": "https://opencodex.local/schemas/oef/phase4/capability-observation-v1.schema.json"
}
