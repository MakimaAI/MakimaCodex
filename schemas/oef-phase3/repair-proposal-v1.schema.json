{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "number",
      "const": 1
    },
    "repair_proposal_id": {
      "type": "string",
      "pattern": "^repair-proposal:.*"
    },
    "task_id": {
      "type": "string",
      "pattern": "^task:.*"
    },
    "source_review_plan_id": {
      "type": "string",
      "pattern": "^review-plan:.*"
    },
    "target_findings": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^review-finding:.*"
      }
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "object",
      "properties": {
        "allowed_paths": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "allowed_paths"
      ],
      "additionalProperties": false
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "required_evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    }
  },
  "required": [
    "schema_version",
    "repair_proposal_id",
    "task_id",
    "source_review_plan_id",
    "target_findings",
    "objective",
    "scope",
    "constraints",
    "required_evidence",
    "created_at"
  ],
  "additionalProperties": false,
  "$id": "https://opencodex.local/schemas/oef/phase3/repair-proposal-v1.schema.json"
}
