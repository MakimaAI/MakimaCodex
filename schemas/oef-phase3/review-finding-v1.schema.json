{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "number",
      "const": 1
    },
    "finding_id": {
      "type": "string",
      "pattern": "^review-finding:[A-Za-z0-9][A-Za-z0-9._:@/-]*$"
    },
    "finding_key": {
      "type": "string",
      "pattern": "^FIND-[A-Z0-9-]+$"
    },
    "review_plan_id": {
      "type": "string",
      "pattern": "^review-plan:[A-Za-z0-9][A-Za-z0-9._:@/-]*$"
    },
    "review_unit_id": {
      "type": "string",
      "pattern": "^review-unit:[A-Za-z0-9][A-Za-z0-9._:@/-]*$"
    },
    "category": {
      "type": "string",
      "maxLength": 160,
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "proposed_severity": {
      "type": "string",
      "enum": [
        "CRITICAL",
        "HIGH",
        "MEDIUM",
        "LOW",
        "INFO"
      ]
    },
    "effective_severity": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "CRITICAL",
            "HIGH",
            "MEDIUM",
            "LOW",
            "INFO"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "PROPOSED",
        "VALIDATING",
        "CONFIRMED",
        "DISMISSED",
        "DUPLICATE",
        "RESOLVED",
        "VERIFIED_RESOLVED",
        "WAIVED",
        "SUPERSEDED",
        "STALE"
      ]
    },
    "claim": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "impact": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "scope": {
      "type": "object",
      "properties": {
        "snapshot_hash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "contract_revision_id": {
          "type": "string",
          "pattern": "^contract-revision:[A-Za-z0-9][A-Za-z0-9._:@/-]*$"
        },
        "source_tree_hash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "diff_hash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      },
      "required": [
        "snapshot_hash",
        "contract_revision_id",
        "source_tree_hash",
        "diff_hash"
      ],
      "additionalProperties": false
    },
    "anchors": {
      "minItems": 1,
      "maxItems": 64,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "const": "code"
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "line_start": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "line_end": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "file_hash": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "symbol": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": [
                      "function",
                      "method",
                      "class",
                      "module",
                      "json-pointer",
                      "yaml-path"
                    ]
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500
                  }
                },
                "required": [
                  "type",
                  "name"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "snippet_hash": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          }
        },
        "required": [
          "type",
          "path",
          "line_start",
          "line_end",
          "file_hash",
          "symbol",
          "snippet_hash"
        ],
        "additionalProperties": false
      }
    },
    "contract_refs": {
      "maxItems": 64,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300
      }
    },
    "evidence_refs": {
      "maxItems": 256,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    },
    "evidence_strength": {
      "type": "string",
      "enum": [
        "AUTHORITATIVE",
        "STRONG",
        "SUPPORTED",
        "OPINION",
        "UNSUPPORTED"
      ]
    },
    "proposed_by": {
      "type": "object",
      "properties": {
        "reviewer_binding_id": {
          "type": "string",
          "pattern": "^reviewer-binding:[A-Za-z0-9][A-Za-z0-9._:@/-]*$"
        }
      },
      "required": [
        "reviewer_binding_id"
      ],
      "additionalProperties": false
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "duplicate_of": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^review-finding:[A-Za-z0-9][A-Za-z0-9._:@/-]*$"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "finding_id",
    "finding_key",
    "review_plan_id",
    "review_unit_id",
    "category",
    "proposed_severity",
    "effective_severity",
    "confidence",
    "status",
    "claim",
    "impact",
    "scope",
    "anchors",
    "contract_refs",
    "evidence_refs",
    "evidence_strength",
    "proposed_by",
    "created_at",
    "updated_at",
    "duplicate_of"
  ],
  "additionalProperties": false,
  "$id": "https://opencodex.local/schemas/oef/phase3/review-finding-v1.schema.json"
}
