{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "number",
      "const": 1
    },
    "waiver_id": {
      "type": "string",
      "pattern": "^review-waiver:[A-Za-z0-9][A-Za-z0-9._:@/-]*$"
    },
    "finding_id": {
      "type": "string",
      "pattern": "^review-finding:[A-Za-z0-9][A-Za-z0-9._:@/-]*$"
    },
    "decision": {
      "type": "string",
      "const": "ACCEPTED_RISK"
    },
    "rationale": {
      "type": "string",
      "minLength": 1,
      "maxLength": 10000
    },
    "approved_by": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "human",
            "agent",
            "system",
            "integration",
            "scheduler"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "model_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "runtime_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        }
      },
      "required": [
        "type",
        "id"
      ],
      "additionalProperties": false
    },
    "expires_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
        },
        {
          "type": "null"
        }
      ]
    },
    "conditions": {
      "maxItems": 64,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      }
    },
    "snapshot_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "finding_snapshot_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "finding_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "effective_severity_at_approval": {
      "type": "string",
      "enum": [
        "CRITICAL",
        "HIGH",
        "MEDIUM",
        "LOW",
        "INFO"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "status": {
      "type": "string",
      "enum": [
        "ACTIVE",
        "EXPIRED",
        "REVOKED",
        "STALE"
      ]
    }
  },
  "required": [
    "schema_version",
    "waiver_id",
    "finding_id",
    "decision",
    "rationale",
    "approved_by",
    "expires_at",
    "conditions",
    "snapshot_hash",
    "finding_snapshot_hash",
    "finding_hash",
    "effective_severity_at_approval",
    "created_at",
    "status"
  ],
  "additionalProperties": false,
  "$id": "https://opencodex.local/schemas/oef/phase3/waiver-v1.schema.json"
}
