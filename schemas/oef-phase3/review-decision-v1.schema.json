{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "number",
      "const": 1
    },
    "review_decision_id": {
      "type": "string",
      "pattern": "^review-decision:[A-Za-z0-9][A-Za-z0-9._:@/-]*$"
    },
    "review_plan_id": {
      "type": "string",
      "pattern": "^review-plan:[A-Za-z0-9][A-Za-z0-9._:@/-]*$"
    },
    "snapshot_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "decision": {
      "type": "string",
      "enum": [
        "PASS",
        "PASS_WITH_NOTES",
        "CHANGES_REQUESTED",
        "BLOCKED",
        "NEEDS_HUMAN",
        "INCONCLUSIVE",
        "CANCELLED",
        "SUPERSEDED"
      ]
    },
    "decision_source": {
      "type": "string",
      "enum": [
        "deterministic-policy",
        "adjudicator",
        "human"
      ]
    },
    "current_snapshot": {
      "type": "boolean"
    },
    "quorum_satisfied": {
      "type": "boolean"
    },
    "mechanical_verification_passed": {
      "type": "boolean"
    },
    "accepted_findings": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^review-finding:[A-Za-z0-9][A-Za-z0-9._:@/-]*$"
      }
    },
    "dismissed_findings": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^review-finding:[A-Za-z0-9][A-Za-z0-9._:@/-]*$"
      }
    },
    "unresolved_findings": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^review-finding:[A-Za-z0-9][A-Za-z0-9._:@/-]*$"
      }
    },
    "waived_findings": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^review-finding:[A-Za-z0-9][A-Za-z0-9._:@/-]*$"
      }
    },
    "waiver_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^review-waiver:[A-Za-z0-9][A-Za-z0-9._:@/-]*$"
      }
    },
    "human_approval": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "approval_id": {
              "type": "string",
              "pattern": "^review-approval:[A-Za-z0-9][A-Za-z0-9._:@/-]*$"
            },
            "approval_hash": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            "approval_artifact_ref": {
              "type": "string",
              "pattern": "^artifact:[A-Za-z0-9][A-Za-z0-9._:@/-]*$"
            }
          },
          "required": [
            "approval_id",
            "approval_hash",
            "approval_artifact_ref"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "severity_counts": {
      "type": "object",
      "properties": {
        "CRITICAL": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "HIGH": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "MEDIUM": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "LOW": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "INFO": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "CRITICAL",
        "HIGH",
        "MEDIUM",
        "LOW",
        "INFO"
      ],
      "additionalProperties": false
    },
    "reason_codes": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      }
    },
    "rationale": {
      "type": "string",
      "minLength": 1,
      "maxLength": 50000
    },
    "next_action": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "phase1-verdict",
            "repair",
            "human-gate",
            "redispatch",
            "none"
          ]
        },
        "ref": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    "decision_artifact_ref": {
      "type": "string",
      "pattern": "^artifact:[A-Za-z0-9][A-Za-z0-9._:@/-]*$"
    },
    "issued_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    }
  },
  "required": [
    "schema_version",
    "review_decision_id",
    "review_plan_id",
    "snapshot_hash",
    "decision",
    "decision_source",
    "current_snapshot",
    "quorum_satisfied",
    "mechanical_verification_passed",
    "accepted_findings",
    "dismissed_findings",
    "unresolved_findings",
    "waived_findings",
    "waiver_ids",
    "human_approval",
    "severity_counts",
    "reason_codes",
    "rationale",
    "next_action",
    "decision_artifact_ref",
    "issued_at"
  ],
  "additionalProperties": false,
  "$id": "https://opencodex.local/schemas/oef/phase3/review-decision-v1.schema.json"
}
