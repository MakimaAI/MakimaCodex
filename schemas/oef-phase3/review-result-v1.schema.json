{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "number",
      "const": 1
    },
    "review_unit_id": {
      "type": "string",
      "pattern": "^review-unit:[A-Za-z0-9][A-Za-z0-9._:@/-]*$"
    },
    "snapshot_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "decision": {
      "type": "object",
      "properties": {
        "recommendation": {
          "type": "string",
          "enum": [
            "pass",
            "changes-requested",
            "blocked",
            "needs-human",
            "inconclusive"
          ]
        }
      },
      "required": [
        "recommendation"
      ],
      "additionalProperties": false
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 50000
    },
    "findings": {
      "maxItems": 1000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "finding_key": {
            "type": "string",
            "pattern": "^FIND-[A-Z0-9-]+$"
          },
          "category": {
            "type": "string",
            "maxLength": 160,
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "proposed_severity": {
            "type": "string",
            "enum": [
              "CRITICAL",
              "HIGH",
              "MEDIUM",
              "LOW",
              "INFO"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "claim": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000
          },
          "impact": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000
          },
          "contract_refs": {
            "maxItems": 64,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            }
          },
          "code_locations": {
            "minItems": 1,
            "maxItems": 64,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4000
                },
                "start_line": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "end_line": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "file_hash": {
                  "type": "string",
                  "pattern": "^sha256:[a-f0-9]{64}$"
                }
              },
              "required": [
                "path",
                "start_line",
                "end_line",
                "file_hash"
              ],
              "additionalProperties": false
            }
          },
          "evidence_refs": {
            "maxItems": 256,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            }
          },
          "verification": {
            "type": "object",
            "properties": {
              "reproducible": {
                "type": "boolean"
              },
              "reproduction_steps": {
                "maxItems": 64,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4000
                }
              }
            },
            "required": [
              "reproducible",
              "reproduction_steps"
            ],
            "additionalProperties": false
          },
          "recommendation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000
          }
        },
        "required": [
          "finding_key",
          "category",
          "proposed_severity",
          "confidence",
          "claim",
          "impact",
          "contract_refs",
          "code_locations",
          "evidence_refs",
          "verification",
          "recommendation"
        ],
        "additionalProperties": false
      }
    },
    "unanswered_questions": {
      "maxItems": 256,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 10000
      }
    },
    "requested_evidence": {
      "maxItems": 256,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    }
  },
  "required": [
    "schema_version",
    "review_unit_id",
    "snapshot_hash",
    "decision",
    "summary",
    "findings",
    "unanswered_questions",
    "requested_evidence"
  ],
  "additionalProperties": false,
  "$id": "https://opencodex.local/schemas/oef/phase3/review-result-v1.schema.json"
}
