{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "number",
      "const": 1
    },
    "approval_id": {
      "type": "string",
      "pattern": "^review-approval:[A-Za-z0-9][A-Za-z0-9._:@/-]*$"
    },
    "review_plan_id": {
      "type": "string",
      "pattern": "^review-plan:[A-Za-z0-9][A-Za-z0-9._:@/-]*$"
    },
    "snapshot_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "review_decision_id": {
      "type": "string",
      "pattern": "^review-decision:[A-Za-z0-9][A-Za-z0-9._:@/-]*$"
    },
    "review_decision_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "finding_ids": {
      "maxItems": 1000,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^review-finding:[A-Za-z0-9][A-Za-z0-9._:@/-]*$"
      }
    },
    "decision": {
      "type": "string",
      "const": "APPROVE"
    },
    "rationale": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "approved_by": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "human",
            "agent",
            "system",
            "integration",
            "scheduler"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "model_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "runtime_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        }
      },
      "required": [
        "type",
        "id"
      ],
      "additionalProperties": false
    },
    "approval_artifact_ref": {
      "type": "string",
      "pattern": "^artifact:[A-Za-z0-9][A-Za-z0-9._:@/-]*$"
    },
    "approved_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "approval_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  },
  "required": [
    "schema_version",
    "approval_id",
    "review_plan_id",
    "snapshot_hash",
    "review_decision_id",
    "review_decision_hash",
    "finding_ids",
    "decision",
    "rationale",
    "approved_by",
    "approval_artifact_ref",
    "approved_at",
    "approval_hash"
  ],
  "additionalProperties": false,
  "$id": "https://opencodex.local/schemas/oef/phase3/human-review-approval-v1.schema.json"
}
