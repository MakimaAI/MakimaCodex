{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "number",
      "const": 1
    },
    "reviewer_binding_id": {
      "type": "string",
      "pattern": "^reviewer-binding:[A-Za-z0-9][A-Za-z0-9._:@/-]*$"
    },
    "review_unit_id": {
      "type": "string",
      "pattern": "^review-unit:[A-Za-z0-9][A-Za-z0-9._:@/-]*$"
    },
    "reviewer_profile_ref": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "hash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      },
      "required": [
        "id",
        "version",
        "hash"
      ],
      "additionalProperties": false
    },
    "runtime_ref": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "adapter_version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        }
      },
      "required": [
        "id",
        "adapter_version"
      ],
      "additionalProperties": false
    },
    "model_ref": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string",
          "maxLength": 160,
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "model_class": {
          "type": "string",
          "maxLength": 160,
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "resolved_model": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "provider",
        "model_class",
        "resolved_model"
      ],
      "additionalProperties": false
    },
    "reviewer_capabilities": {
      "minItems": 1,
      "maxItems": 11,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "diff-analysis",
          "repository-navigation",
          "architecture-reasoning",
          "security-analysis",
          "multimodal-review",
          "browser-observation",
          "accessibility-analysis",
          "performance-analysis",
          "structured-findings",
          "evidence-citation",
          "contract-traceability"
        ]
      }
    },
    "risk_level": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "independence": {
      "type": "object",
      "properties": {
        "implementer": {
          "type": "object",
          "properties": {
            "agent_id": {
              "type": "string",
              "pattern": "^agent:[A-Za-z0-9][A-Za-z0-9._:@/-]*$"
            },
            "provider": {
              "type": "string",
              "maxLength": 160,
              "pattern": "^[a-z0-9][a-z0-9._-]*$"
            },
            "model_class": {
              "type": "string",
              "maxLength": 160,
              "pattern": "^[a-z0-9][a-z0-9._-]*$"
            },
            "session_id": {
              "type": "string",
              "pattern": "^session:[A-Za-z0-9][A-Za-z0-9._:@/-]*$"
            },
            "context_id": {
              "type": "string",
              "pattern": "^context:[A-Za-z0-9][A-Za-z0-9._:@/-]*$"
            }
          },
          "required": [
            "agent_id",
            "provider",
            "model_class",
            "session_id",
            "context_id"
          ],
          "additionalProperties": false
        },
        "reviewer": {
          "type": "object",
          "properties": {
            "agent_id": {
              "type": "string",
              "pattern": "^agent:[A-Za-z0-9][A-Za-z0-9._:@/-]*$"
            },
            "provider": {
              "type": "string",
              "maxLength": 160,
              "pattern": "^[a-z0-9][a-z0-9._-]*$"
            },
            "model_class": {
              "type": "string",
              "maxLength": 160,
              "pattern": "^[a-z0-9][a-z0-9._-]*$"
            },
            "session_id": {
              "type": "string",
              "pattern": "^session:[A-Za-z0-9][A-Za-z0-9._:@/-]*$"
            },
            "context_id": {
              "type": "string",
              "pattern": "^context:[A-Za-z0-9][A-Za-z0-9._:@/-]*$"
            }
          },
          "required": [
            "agent_id",
            "provider",
            "model_class",
            "session_id",
            "context_id"
          ],
          "additionalProperties": false
        },
        "source_access": {
          "type": "string",
          "const": "read-only"
        },
        "human_approval_required": {
          "type": "boolean"
        }
      },
      "required": [
        "implementer",
        "reviewer",
        "source_access",
        "human_approval_required"
      ],
      "additionalProperties": false
    },
    "created_by": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "human",
            "agent",
            "system",
            "integration",
            "scheduler"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "model_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "runtime_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        }
      },
      "required": [
        "type",
        "id"
      ],
      "additionalProperties": false
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    }
  },
  "required": [
    "schema_version",
    "reviewer_binding_id",
    "review_unit_id",
    "reviewer_profile_ref",
    "runtime_ref",
    "model_ref",
    "reviewer_capabilities",
    "risk_level",
    "independence",
    "created_by",
    "created_at"
  ],
  "additionalProperties": false,
  "$id": "https://opencodex.local/schemas/oef/phase3/reviewer-binding-v1.schema.json"
}
