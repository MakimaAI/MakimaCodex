{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "number",
      "const": 1
    },
    "role_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "type": "string",
      "enum": [
        "analysis",
        "production",
        "verification",
        "governance"
      ]
    },
    "required_capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "incompatible_roles": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "optional": {
      "type": "boolean"
    },
    "role_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  },
  "required": [
    "schema_version",
    "role_id",
    "version",
    "objective",
    "category",
    "required_capabilities",
    "permissions",
    "outputs",
    "incompatible_roles",
    "optional",
    "role_hash"
  ],
  "additionalProperties": false,
  "$id": "https://opencodex.local/schemas/oef/phase5/role-definition-v1.schema.json"
}
