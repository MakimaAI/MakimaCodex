{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "number",
      "const": 1
    },
    "team_blueprint_id": {
      "type": "string",
      "pattern": "^team-blueprint:[A-Za-z0-9][A-Za-z0-9._:@/-]*$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "advisory_roles": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "applicability": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "blueprint_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  },
  "required": [
    "schema_version",
    "team_blueprint_id",
    "version",
    "name",
    "advisory_roles",
    "applicability",
    "blueprint_hash"
  ],
  "additionalProperties": false,
  "$id": "https://opencodex.local/schemas/oef/phase5/team-blueprint-v1.schema.json"
}
