{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "number",
      "const": 1
    },
    "team_plan_id": {
      "type": "string",
      "pattern": "^team-plan:[A-Za-z0-9][A-Za-z0-9._:@/-]*$"
    },
    "revision": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "task_id": {
      "type": "string",
      "pattern": "^task:[A-Za-z0-9][A-Za-z0-9._:@/-]*$"
    },
    "fingerprint_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "role_catalog_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "nodes": {
      "minItems": 1,
      "maxItems": 8,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "role_node_id": {
            "type": "string",
            "pattern": "^role-node:[A-Za-z0-9][A-Za-z0-9._:@/-]*$"
          },
          "role_id": {
            "type": "string"
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "status": {
            "type": "string",
            "enum": [
              "WAITING",
              "READY",
              "BOUND",
              "RUNNING",
              "COMPLETED",
              "FAILED",
              "BLOCKED",
              "SKIPPED",
              "SUPERSEDED"
            ]
          },
          "path_scope": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "mandatory": {
            "type": "boolean"
          }
        },
        "required": [
          "role_node_id",
          "role_id",
          "depends_on",
          "status",
          "path_scope",
          "mandatory"
        ],
        "additionalProperties": false
      }
    },
    "max_parallelism": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    },
    "architect_proposal_applied": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "architect_proposal_rejected": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "team_plan_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  },
  "required": [
    "schema_version",
    "team_plan_id",
    "revision",
    "task_id",
    "fingerprint_hash",
    "role_catalog_hash",
    "nodes",
    "max_parallelism",
    "architect_proposal_applied",
    "architect_proposal_rejected",
    "team_plan_hash"
  ],
  "additionalProperties": false,
  "$id": "https://opencodex.local/schemas/oef/phase5/team-plan-v1.schema.json"
}
