{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "number",
      "const": 1
    },
    "candidate_set_id": {
      "type": "string",
      "pattern": "^candidate-set:[A-Za-z0-9][A-Za-z0-9._:@/-]*$"
    },
    "role_id": {
      "type": "string",
      "minLength": 1
    },
    "eligible": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "schema_version": {
            "type": "number",
            "const": 1
          },
          "candidate_id": {
            "type": "string",
            "pattern": "^candidate:[A-Za-z0-9][A-Za-z0-9._:@/-]*$"
          },
          "role_id": {
            "type": "string",
            "minLength": 1
          },
          "agent_profile_id": {
            "type": "string",
            "pattern": "^agent-profile:[A-Za-z0-9][A-Za-z0-9._:@/-]*$"
          },
          "agent_profile_version": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+$"
          },
          "agent_profile_hash": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "execution_config_id": {
            "type": "string",
            "pattern": "^execution-config:[A-Za-z0-9][A-Za-z0-9._:@/-]*$"
          },
          "execution_config_hash": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "scorecard_id": {
            "type": "string",
            "minLength": 1
          },
          "scorecard_hash": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "provider_id": {
            "type": "string",
            "pattern": "^provider:[A-Za-z0-9][A-Za-z0-9._:@/-]*$"
          },
          "model_version_id": {
            "type": "string",
            "pattern": "^model-version:[A-Za-z0-9][A-Za-z0-9._:@/-]*$"
          },
          "runtime_id": {
            "type": "string",
            "pattern": "^runtime:[A-Za-z0-9][A-Za-z0-9._:@/-]*$"
          },
          "runtime_adapter_version": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+$"
          },
          "deployment_id": {
            "type": "string",
            "pattern": "^deployment:[A-Za-z0-9][A-Za-z0-9._:@/-]*$"
          },
          "qualification_level": {
            "type": "string",
            "enum": [
              "Q0",
              "Q1",
              "Q2",
              "Q3",
              "Q4",
              "Q5"
            ]
          },
          "lifecycle_status": {
            "type": "string",
            "enum": [
              "valid",
              "stale",
              "expired",
              "quarantined"
            ]
          },
          "valid_until": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
          },
          "capabilities": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "modalities": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "context_tokens": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "permission_envelope": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "sandbox_enforced": {
            "type": "boolean"
          },
          "privacy_classes": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "public",
                "internal",
                "confidential",
                "restricted"
              ]
            }
          },
          "metrics": {
            "type": "object",
            "properties": {
              "role_quality": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "task_similarity": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "repository_affinity": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "tool_reliability": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "structured_output_reliability": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "operational_reliability": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "availability": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "confidence_lower": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "confidence_mean": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "incident_penalty": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "staleness_penalty": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "cost_p50": {
                "type": "number",
                "minimum": 0
              },
              "cost_p90": {
                "type": "number",
                "minimum": 0
              },
              "latency_p50_ms": {
                "type": "number",
                "minimum": 0
              },
              "latency_p90_ms": {
                "type": "number",
                "minimum": 0
              }
            },
            "required": [
              "role_quality",
              "task_similarity",
              "repository_affinity",
              "tool_reliability",
              "structured_output_reliability",
              "operational_reliability",
              "availability",
              "confidence_lower",
              "confidence_mean",
              "incident_penalty",
              "staleness_penalty",
              "cost_p50",
              "cost_p90",
              "latency_p50_ms",
              "latency_p90_ms"
            ],
            "additionalProperties": false
          },
          "availability": {
            "type": "object",
            "properties": {
              "runtime_healthy": {
                "type": "boolean"
              },
              "provider_healthy": {
                "type": "boolean"
              },
              "account_capacity": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "observed_at": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
              },
              "expires_at": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
              }
            },
            "required": [
              "runtime_healthy",
              "provider_healthy",
              "account_capacity",
              "observed_at",
              "expires_at"
            ],
            "additionalProperties": false
          },
          "account_pool": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "candidate_hash": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          }
        },
        "required": [
          "schema_version",
          "candidate_id",
          "role_id",
          "agent_profile_id",
          "agent_profile_version",
          "agent_profile_hash",
          "execution_config_id",
          "execution_config_hash",
          "scorecard_id",
          "scorecard_hash",
          "provider_id",
          "model_version_id",
          "runtime_id",
          "runtime_adapter_version",
          "deployment_id",
          "qualification_level",
          "lifecycle_status",
          "valid_until",
          "capabilities",
          "modalities",
          "context_tokens",
          "permission_envelope",
          "sandbox_enforced",
          "privacy_classes",
          "metrics",
          "availability",
          "account_pool",
          "candidate_hash"
        ],
        "additionalProperties": false
      }
    },
    "rejected": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "candidate_id": {
            "type": "string",
            "pattern": "^candidate:[A-Za-z0-9][A-Za-z0-9._:@/-]*$"
          },
          "reasons": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "candidate_id",
          "reasons"
        ],
        "additionalProperties": false
      }
    },
    "candidate_set_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  },
  "required": [
    "schema_version",
    "candidate_set_id",
    "role_id",
    "eligible",
    "rejected",
    "candidate_set_hash"
  ],
  "additionalProperties": false,
  "$id": "https://opencodex.local/schemas/oef/phase5/candidate-set-v1.schema.json"
}
