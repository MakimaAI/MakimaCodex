{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "number",
      "const": 1
    },
    "routing_outcome_id": {
      "type": "string",
      "pattern": "^routing-outcome:[A-Za-z0-9][A-Za-z0-9._:@/-]*$"
    },
    "task_id": {
      "type": "string",
      "pattern": "^task:[A-Za-z0-9][A-Za-z0-9._:@/-]*$"
    },
    "routing_plan_id": {
      "type": "string",
      "pattern": "^routing-plan:[A-Za-z0-9][A-Za-z0-9._:@/-]*$"
    },
    "binding_set_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "status": {
      "type": "string",
      "enum": [
        "ACCEPTED",
        "REJECTED",
        "FAILED",
        "CANCELLED"
      ]
    },
    "selection_mode": {
      "type": "string",
      "enum": [
        "deterministic-router",
        "human-override",
        "shadow"
      ]
    },
    "role_results": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "role_id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "COMPLETED",
              "FAILED",
              "BLOCKED",
              "SKIPPED"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^artifact:[A-Za-z0-9][A-Za-z0-9._:@/-]*$"
            }
          }
        },
        "required": [
          "role_id",
          "status",
          "evidence_refs"
        ],
        "additionalProperties": false
      }
    },
    "fallback_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "policy_updated_online": {
      "type": "boolean",
      "const": false
    },
    "offline_calibration_status": {
      "type": "string",
      "enum": [
        "QUEUED",
        "NOT_QUEUED"
      ]
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "outcome_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  },
  "required": [
    "schema_version",
    "routing_outcome_id",
    "task_id",
    "routing_plan_id",
    "binding_set_hash",
    "status",
    "selection_mode",
    "role_results",
    "fallback_count",
    "policy_updated_online",
    "offline_calibration_status",
    "recorded_at",
    "outcome_hash"
  ],
  "additionalProperties": false,
  "$id": "https://opencodex.local/schemas/oef/phase5/routing-outcome-v1.schema.json"
}
