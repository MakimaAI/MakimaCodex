{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "number",
      "const": 1
    },
    "fingerprint_id": {
      "type": "string",
      "pattern": "^task-fingerprint:[A-Za-z0-9][A-Za-z0-9._:@/-]*$"
    },
    "revision": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "compiler_input_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "task_id": {
      "type": "string",
      "pattern": "^task:[A-Za-z0-9][A-Za-z0-9._:@/-]*$"
    },
    "contract_ref": {
      "type": "object",
      "properties": {
        "revision_id": {
          "type": "string",
          "pattern": "^contract-revision:[A-Za-z0-9][A-Za-z0-9._:@/-]*$"
        },
        "hash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      },
      "required": [
        "revision_id",
        "hash"
      ],
      "additionalProperties": false
    },
    "objective": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "task_types": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "domains": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "signals": {
      "type": "object",
      "properties": {
        "languages": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "has_frontend": {
          "type": "boolean"
        },
        "has_3d": {
          "type": "boolean"
        },
        "external_api": {
          "type": "boolean"
        },
        "credential_sensitive": {
          "type": "boolean"
        }
      },
      "required": [
        "languages",
        "paths",
        "has_frontend",
        "has_3d",
        "external_api",
        "credential_sensitive"
      ],
      "additionalProperties": false
    },
    "required_capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "modalities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "freshness": {
      "type": "string",
      "enum": [
        "not-required",
        "recommended",
        "required"
      ]
    },
    "risk": {
      "type": "object",
      "properties": {
        "level": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ]
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "level",
        "reasons"
      ],
      "additionalProperties": false
    },
    "privacy": {
      "type": "string",
      "enum": [
        "public",
        "internal",
        "confidential",
        "restricted"
      ]
    },
    "complexity": {
      "type": "object",
      "properties": {
        "level": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "level",
        "score"
      ],
      "additionalProperties": false
    },
    "uncertainty": {
      "type": "object",
      "properties": {
        "level": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "unresolved": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "level",
        "score",
        "unresolved"
      ],
      "additionalProperties": false
    },
    "scope": {
      "type": "object",
      "properties": {
        "paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "parallelizable": {
          "type": "boolean"
        }
      },
      "required": [
        "paths",
        "parallelizable"
      ],
      "additionalProperties": false
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "feature_key": {
            "type": "string",
            "minLength": 1
          },
          "value": {},
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "source": {
            "type": "string",
            "enum": [
              "kernel-rule",
              "task-contract",
              "repository-scan",
              "human-metadata",
              "semantic-classifier",
              "model-proposal"
            ]
          },
          "observed_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
          },
          "hard_constraint_eligible": {
            "type": "boolean"
          }
        },
        "required": [
          "feature_key",
          "value",
          "confidence",
          "source",
          "observed_at",
          "hard_constraint_eligible"
        ],
        "additionalProperties": false
      }
    },
    "hard_constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "compiled_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "fingerprint_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  },
  "required": [
    "schema_version",
    "fingerprint_id",
    "revision",
    "compiler_input_hash",
    "task_id",
    "contract_ref",
    "objective",
    "task_types",
    "domains",
    "signals",
    "required_capabilities",
    "modalities",
    "freshness",
    "risk",
    "privacy",
    "complexity",
    "uncertainty",
    "scope",
    "observations",
    "hard_constraints",
    "compiled_at",
    "fingerprint_hash"
  ],
  "additionalProperties": false,
  "$id": "https://opencodex.local/schemas/oef/phase5/task-fingerprint-v1.schema.json"
}
